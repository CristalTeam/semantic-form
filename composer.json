{
    "name": "cristal/semantic-form",
    "description": "Semantic-UI form helpers",
    "keywords": [
        "laravel",
        "laravolt",
        "form",
        "semantic-UI"
    ],
    "homepage": "https://github.com/laravolt/semantic-form",
    "license": "MIT",
    "authors": [
        {
            "name": "Bayu Hendra Winata",
            "email": "uyab.exe@gmail.com",
            "homepage": "http://id-laravel.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^12.11|^13.0",
        "nesbot/carbon": "^3.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Laravolt\\SemanticForm\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravolt\\SemanticForm\\Test\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravolt\\SemanticForm\\ServiceProvider"
            ],
            "aliases": {
                "SemanticForm": "Laravolt\\SemanticForm\\Facade"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
